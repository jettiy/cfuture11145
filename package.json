{
  "name": "futures-terminal",
  "version": "1.0.0",
  "description": "Futures Terminal with TradingView, Chat, News, and Signal Analysis",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && uvicorn main:app --reload --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "clean": "node -e \"require('fs').rmSync('frontend/.next', {recursive:true, force:true})\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && echo 'Backend build complete'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
