# Backend environment template. Copy to .env and set real values. Never commit .env.

# Database (optional; default: SQLite backend/futures_terminal.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/futures_terminal

# Auth (required in production)
SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# LLM (translation / briefing)
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# Finnhub API (Economic Calendar, News, Earnings) — 무료 티어 사용
# Get your free API key at: https://finnhub.io/register
FINNHUB_API_KEY=

# CORS (Render/Vercel 배포 시 프론트 도메인만 허용. 쉼표 구분, ["*"] 금지)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-backend.onrender.com

# Cron (Cloudflare Worker → backend; set same value in Worker secrets)
# CRON_SECRET=

# Optional: external APIs
# FMP (Economic Calendar — 무료 제공량 많음) https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=

# ALPHA_VANTAGE_API_KEY=

# Optional: scheduler
# NEWS_UPDATE_INTERVAL_MINUTES=5
